# ============================================================
# ABA Platform — required environment variables
# Copy this file to .env.local and fill in the real values.
# NEVER commit .env.local or any file containing real secrets.
# ============================================================

# ── NextAuth / Auth.js ──────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=

# ── WordPress GraphQL (server-only — see SECURITY.md §1) ───
WP_GRAPHQL_URL=https://your-wp-site.com/graphql

# ── Supabase ────────────────────────────────────────────────
# Project URL: Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
# Anon/public key: Settings → API → Project API keys → anon public
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key (server-only): Settings → API → Project API keys → service_role
SUPABASE_SERVICE_ROLE_KEY=

# ── Stripe ──────────────────────────────────────────────────
# Secret key: Stripe Dashboard → Developers → API keys → Secret key
STRIPE_SECRET_KEY=sk_live_...
# Publishable key (client-visible): Stripe Dashboard → Developers → API keys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
# Webhook signing secret: Stripe Dashboard → Developers → Webhooks → your endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Price IDs — create one Product per tier in Stripe Dashboard,
# then add a Monthly and/or Yearly Price under each product.
# Copy the Price ID (price_...) for each combination below.
# Individual — £8/month
STRIPE_PRICE_INDIVIDUAL_MONTHLY=price_...
# Individual — £90/year
STRIPE_PRICE_INDIVIDUAL_YEARLY=price_...
# SME — £25/month
STRIPE_PRICE_SME_MONTHLY=price_...
# SME — £300/year
STRIPE_PRICE_SME_YEARLY=price_...
# Corporate — £1,000/year (annual only)
STRIPE_PRICE_CORPORATE_YEARLY=price_...

# ── App URL ─────────────────────────────────────────────────
# Required in production so Stripe success/cancel URLs are absolute.
# Example: https://pay.yourdomain.co.uk
NEXT_PUBLIC_APP_URL=

# ── Hostname gating ─────────────────────────────────────────
# Set to the pay subdomain hostname (without scheme) to activate
# host-based route separation in proxy.ts.
# Example: pay.yourdomain.co.uk
# PAY_HOSTNAME=

# ── Rate limiting (Upstash Redis) ───────────────────────────
# Optional in dev; REQUIRED in production (see SECURITY.md §2).
# Create a Redis database at console.upstash.com → REST API.
# UPSTASH_REDIS_REST_URL=https://....upstash.io
# UPSTASH_REDIS_REST_TOKEN=

# ── Admin email notifications (Resend) ──────────────────────
# Optional: if set, ABA staff get an email on every new registration.
# RESEND_API_KEY=re_...
# RESEND_FROM_EMAIL=noreply@yourdomain.co.uk
# ADMIN_NOTIFICATION_EMAIL=admin@yourdomain.co.uk
